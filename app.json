{
  "package_id": "com.chanyaoying.teleglance",
  "edition": "202601",
  "name": "TeleGlance",
  "version": "1.0.51",
  "min_app_version": "2.0.0",
  "min_sdk_version": "0.0.10",
  "entrypoint": "index.html",
  "permissions": [
    {
      "name": "network",
      "desc": "Connects TeleGlance to a self-hosted backend for Telegram and transcription.",
      "whitelist": [
        "http://localhost:8787",
        "http://127.0.0.1:8787",
        "http://<BACKEND_URL>:8787",
        "https://my.telegram.org",
        "https://react.dev/errors/",
        "https://teleglance.akira-os.net"
      ]
    },
    {
      "name": "g2-microphone",
      "desc": "Records short voice replies for transcription before sending."
    }
  ],
  "supported_languages": [
    "en",
    "de",
    "fr",
    "es",
    "it"
  ]
}
