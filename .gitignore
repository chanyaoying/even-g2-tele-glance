server/server/

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Builds and simulator output
artifacts/
*.ehpk
# Per-developer packaging override (backend origin) and the manifest generated from it
app.local.json
.app-build/
*.png
# Old blank-glasses PNG goldens are not tracked (replaced by JSON goldens
# in the same directory). New `.glasses.json` golden files are tracked
# because they contain real captured render models that the harness
# diffs against at runtime — keeping them in git means a stale
# `npm run test:simulator` will surface content regressions.
!web/test/simulator-goldens/*.glasses.json
SECURITY_PRIVACY_FUTURE.md
